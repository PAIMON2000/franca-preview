<Window x:Class="Franca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Franca 游戏翻译启用工具" Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="/Franca;component/Assets/Brand/franca-taskbar.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <BitmapImage x:Key="FrancaMark" UriSource="/Franca;component/Assets/Brand/franca-pixel.png"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 无边框标题条：左为拖拽区（手动 DragMove + 双击最大化，不依赖 WindowChrome 命中链），右为自绘窗口按钮 -->
        <Border Background="{DynamicResource NavBackgroundBrush}"
                MouseLeftButtonDown="OnTitleBarMouseDown"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="False">
                    <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}"
                            Click="OnMinimizeClick"/>
                    <Button x:Name="MaxRestoreButton" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}"
                            Click="OnMaximizeClick"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseWindowButtonStyle}"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Background="{DynamicResource NavBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,10,16,18" IsHitTestVisible="False"
                                AutomationProperties.Name="Franca">
                        <Image Source="{DynamicResource FrancaMark}" Width="80" Height="54" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="BrandLabel" Text="Franca" FontWeight="SemiBold" FontSize="19"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="NavList" Margin="6,0"
                             SelectionChanged="OnNavSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SectionLabel}" FontSize="11" Margin="12,18,0,8"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding StartsAdvancedSection, Converter={StaticResource BoolToVis}}"/>
                                                <Border x:Name="Bd" Padding="10,8" CornerRadius="3" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="150">
                                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}"
                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,2">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   Width="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 页签内容区 -->
            <ContentControl Grid.Column="1" x:Name="PageHost"/>
        </Grid>

        <!-- 底部状态条 -->
        <Border Grid.Row="2" Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Button x:Name="StatusEndpointsButton" Click="OnStatusEndpointsClick"
                        HorizontalAlignment="Left" Padding="8,2">
                    <TextBlock x:Name="StatusEndpointsText"/>
                </Button>
                <TextBlock x:Name="StatusLatestLog" HorizontalAlignment="Right"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="600"/>
            </Grid>
        </Border>
    </Grid>
</Window>
