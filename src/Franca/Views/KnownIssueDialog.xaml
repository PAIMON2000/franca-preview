<Window x:Class="Franca.Views.KnownIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Known issue" Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="530" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <TextBlock x:Name="GameLabel" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="GameText" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>

                <TextBlock x:Name="EvidenceLabel" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="EvidenceText" Style="{StaticResource BodyText}"/>

                <TextBlock x:Name="ReasonLabel" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="ReasonText" Style="{StaticResource BodyText}"/>

                <TextBlock x:Name="RepairLabel" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="RepairText" Style="{StaticResource BodyText}"/>

                <TextBlock x:Name="RuleIdText" Margin="0,18,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ResultText" Grid.Row="1" Margin="0,14,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RepairButton" Click="OnRepairClick" Padding="14,5"/>
            <Button x:Name="CloseButton" Click="OnCloseClick" Padding="14,5" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
