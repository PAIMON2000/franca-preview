<UserControl x:Class="Franca.Views.UpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBackgroundBrush}">
    <StackPanel Margin="24">
        <DockPanel Margin="0,0,0,18">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,4"
                    Click="OnRefreshClick"/>
            <TextBlock x:Name="Title" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock x:Name="VersionText" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="LoadingText" FontSize="15" Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="14" Visibility="Collapsed"/>
        <Button x:Name="DownloadButton" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,6"
                Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Click="OnDownloadClick"/>
    </StackPanel>
</UserControl>
