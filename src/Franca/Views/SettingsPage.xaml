<UserControl x:Class="Franca.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Franca.Views"
             Background="{DynamicResource PageBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Width="620" HorizontalAlignment="Left">
            <TextBlock x:Name="SettingsTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Grid Margin="0,0,16,4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourceLangLabel" Grid.Column="0" Margin="0,0,0,6"/>
                <TextBlock x:Name="TargetLangLabel" Grid.Column="2" Margin="0,0,0,6"/>
                <TextBlock x:Name="SecondaryLangLabel" Grid.Column="4" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="SourceLanguageCombo" Grid.Row="1" Grid.Column="0" MinHeight="30"
                          SelectionChanged="OnSourceChanged"/>
                <TextBlock x:Name="LanguageArrow" Grid.Row="1" Grid.Column="1" Text="→" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                <ComboBox x:Name="LanguageCombo" Grid.Row="1" Grid.Column="2" MinHeight="30"
                          SelectionChanged="OnSettingChanged"/>
                <Border Grid.Column="3" Grid.RowSpan="2" Width="1" HorizontalAlignment="Center"
                        Background="{DynamicResource GridLineBrush}"/>
                <ComboBox x:Name="SecondaryLanguageCombo" Grid.Row="1" Grid.Column="4" MinHeight="30"
                          SelectionChanged="OnSecondaryChanged"/>
                <local:LanguageApplyBar x:Name="LanguageApply" Grid.Row="2" Grid.ColumnSpan="3"/>
                <TextBlock x:Name="SecondaryHint" Grid.Row="2" Grid.Column="4" Margin="0,8,0,0"
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                <TextBlock x:Name="ModeLabel" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeCombo" Width="140" Margin="8,0,4,0"
                          SelectionChanged="OnModeChanged"/>
            </StackPanel>
            <TextBlock x:Name="ModeHint" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeCombo" MinWidth="240" Margin="8,0,4,0" MinHeight="30"
                          SelectionChanged="OnThemeChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Margin="0,0,8,0" CornerRadius="2"
                                        Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="3"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="HideNonGameSoftwareCheck" Margin="0,8,0,0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnHideNonGameSoftwareClick"/>
            <TextBlock x:Name="HideNonGameSoftwareHint" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <CheckBox x:Name="NoOptimizeCheck" Margin="0,8,0,0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnNoOptimizeClick"/>
            <CheckBox x:Name="OverlayCheck" Margin="0,8,0,0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Click="OnOverlayClick"/>
            <TextBlock x:Name="OverlayHint" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="KeyLocalNote" Text="Key 明文仅保存在本机"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
            <Button x:Name="ManageEndpointsButton" Click="OnManageEndpoints" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <!-- 开发者 / Agent 区块 -->
            <Expander x:Name="AgentAdvanced" Margin="0,24,0,0"><Expander.Header><TextBlock x:Name="AgentTitle" FontWeight="SemiBold"/></Expander.Header><StackPanel Margin="0,12,0,0">
            <TextBlock x:Name="AgentDesc" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="AgentText" Margin="0,8,0,0" Height="200"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="AgentCopyButton" Click="OnAgentCopyClick" Padding="10,2"
                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel></Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
