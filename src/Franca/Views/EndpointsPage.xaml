<UserControl x:Class="Franca.Views.EndpointsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Franca.Views"
             Background="{DynamicResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="EndpointPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="EndpointCardTemplate">
            <Border BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="8" Margin="4" Width="260" Background="{DynamicResource CardBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 左侧状态色条 -->
                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{Binding StatusColor}" Margin="-8,-8,0,-8"/>
                    <StackPanel Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock Text="{Binding PrimaryBadge}" Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding FallbackBadge}" Foreground="{DynamicResource OkBrush}"
                                       FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                       FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{Binding DisableActionLabel}" Tag="{Binding}" Click="OnToggleEnabledClick"
                                    Padding="5,1" FontSize="12" Margin="0,0,4,0"
                                    Visibility="{Binding IsLlm, Converter={StaticResource BoolToVis}}"/>
                            <Button x:Name="PrimaryEndpointButton" Content="{Binding PrimaryActionLabel}" Tag="{Binding}" Click="OnSetPrimaryClick"
                                    Style="{StaticResource EndpointPrimaryButtonStyle}" Padding="5,1" FontSize="12"/>
                            <Button Content="{Binding TestButtonLabel}" Tag="{Binding}" Click="OnTestEndpointClick"
                                    IsEnabled="{Binding CanTest}" Padding="5,1" FontSize="12" Margin="4,0,0,0"
                                    Visibility="{Binding IsLlm, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{Binding FallbackActionLabel}" Tag="{Binding}" Click="OnSetFallbackClick" Padding="5,1" FontSize="12" Margin="4,0,0,0"/>
                            <Button Content="{Binding TestButtonLabel}" Tag="{Binding}" Click="OnTestEndpointClick"
                                    IsEnabled="{Binding CanTest}" Padding="5,1" FontSize="12" Margin="4,0,0,0"
                                    Visibility="{Binding ShowTailTest, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{Binding DisableActionLabel}" Tag="{Binding}" Click="OnToggleEnabledClick" Padding="5,1" FontSize="12" Margin="4,0,0,0"
                                    Visibility="{Binding NotLlm, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="✕" Tag="{Binding}" Click="OnDeleteCustomClick" Padding="5,1" FontSize="12" Margin="4,0,0,0"
                                    Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Expander Header="{Binding KeyHeaderLabel}" FontSize="12" Margin="0,2,0,0"
                                  Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding KeyFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Label}" Width="112" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="112" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding SaveKeysLabel}" Tag="{Binding}" Click="OnSaveKeysClick"
                                        Padding="5,1" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AddCardTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="8" Margin="4" Width="260">
                <Button Tag="{Binding}" Click="OnAddEndpointClick" Background="Transparent"
                        BorderThickness="0" Padding="0,16" HorizontalContentAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="＋" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </Border>
        </DataTemplate>

        <local:EndpointCardTemplateSelector x:Key="CardTemplateSelector"
            NormalTemplate="{StaticResource EndpointCardTemplate}"
            AddTemplate="{StaticResource AddCardTemplate}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="EndpointsTitle" FontWeight="SemiBold" FontSize="24" Margin="0,0,0,16"/>
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="18" CornerRadius="6" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="CurrentServiceText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RelayStatusText" Margin="0,8,0,12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <WrapPanel>
                        <Button x:Name="AutoFreeButton" Click="OnUseAutoFree" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,4"/>
                        <Button x:Name="TestAllButton" Click="OnTestAllClick" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="FreeSectionLabel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Expander x:Name="FreeAdvanced" Margin="0,0,0,20">
                <ItemsControl x:Name="FreeCards" ItemTemplateSelector="{StaticResource CardTemplateSelector}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
            <TextBlock x:Name="LlmSectionLabel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border x:Name="DeepSeekPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="1" Padding="18" CornerRadius="6" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="DeepSeek API" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock x:Name="KeyLocalNote" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="API Key" FontSize="12" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="DeepSeekKeyBox" MinHeight="34" Width="560" HorizontalAlignment="Left"
                                 AutomationProperties.Name="DeepSeek API Key"
                                 HorizontalContentAlignment="Left" Padding="8"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveDeepSeekButton" Click="OnSaveDeepSeek" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="DisableDeepSeekButton" Content="{Binding DisableActionLabel}" Tag="{Binding}" Click="OnToggleEnabledClick" Margin="0,0,8,6"/>
                        <Button x:Name="UseDeepSeekButton" Click="OnUseDeepSeek" Tag="{Binding}"
                                Style="{StaticResource EndpointPrimaryButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="TestDeepSeekButton" Click="OnTestDeepSeek" Margin="0,0,8,6"/>
                        <Button x:Name="DeleteDeepSeekButton" Click="OnDeleteDeepSeek" Margin="0,0,8,6"/>
                        <Button x:Name="DeepSeekPlatformButton" Click="OnOpenDeepSeekPlatform" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="DeepSeekStatus" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="KimiPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="1" Padding="18" CornerRadius="6" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Kimi API" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock x:Name="KimiKeyNote" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="API Key" FontSize="12" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="KimiKeyBox" MinHeight="34" Width="560" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Kimi API Key"
                                 HorizontalContentAlignment="Left" Padding="8"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveKimiButton" Click="OnSaveKimi" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="DisableKimiButton" Content="{Binding DisableActionLabel}" Tag="{Binding}" Click="OnToggleEnabledClick" Margin="0,0,8,6"/>
                        <Button x:Name="UseKimiButton" Click="OnUseKimi" Tag="{Binding}"
                                Style="{StaticResource EndpointPrimaryButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="TestKimiButton" Click="OnTestKimi" Margin="0,0,8,6"/>
                        <Button x:Name="DeleteKimiButton" Click="OnDeleteKimi" Margin="0,0,8,6"/>
                        <Button x:Name="KimiPlatformCnButton" Click="OnOpenKimiPlatform" Margin="0,0,8,6"/>
                        <Button x:Name="KimiPlatformIntlButton" Click="OnOpenKimiIntlPlatform" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="KimiStatus" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="OpenAiPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="1" Padding="18" CornerRadius="6" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="OpenAI API" FontWeight="SemiBold" FontSize="17"/>
                    <TextBlock x:Name="OpenAiKeyNote" TextWrapping="Wrap" Margin="0,8,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="API Key" FontSize="12" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="OpenAiKeyBox" MinHeight="34" Width="560" HorizontalAlignment="Left"
                                 AutomationProperties.Name="OpenAI API Key"
                                 HorizontalContentAlignment="Left" Padding="8"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="SaveOpenAiButton" Click="OnSaveOpenAi" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="DisableOpenAiButton" Content="{Binding DisableActionLabel}" Tag="{Binding}" Click="OnToggleEnabledClick" Margin="0,0,8,6"/>
                        <Button x:Name="UseOpenAiButton" Click="OnUseOpenAi" Tag="{Binding}"
                                Style="{StaticResource EndpointPrimaryButtonStyle}" Margin="0,0,8,6"/>
                        <Button x:Name="TestOpenAiButton" Click="OnTestOpenAi" Margin="0,0,8,6"/>
                        <Button x:Name="DeleteOpenAiButton" Click="OnDeleteOpenAi" Margin="0,0,8,6"/>
                        <Button x:Name="OpenAiPlatformButton" Click="OnOpenOpenAiPlatform" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="OpenAiStatus" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="LlmCards" ItemTemplateSelector="{StaticResource CardTemplateSelector}" Margin="0,0,0,18">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Expander x:Name="ByokAdvanced" Margin="0,0,0,18">
                <Expander.Header><TextBlock x:Name="ByokSectionLabel" FontSize="18" FontWeight="SemiBold"/></Expander.Header>
                <ItemsControl x:Name="ByokCards" ItemTemplateSelector="{StaticResource CardTemplateSelector}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
            <Expander x:Name="OfflineAdvanced" Margin="0,0,0,18">
                <Expander.Header><TextBlock x:Name="OfflineSectionLabel" FontSize="18" FontWeight="SemiBold"/></Expander.Header>
                <ItemsControl x:Name="OfflineCards" ItemTemplateSelector="{StaticResource CardTemplateSelector}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
