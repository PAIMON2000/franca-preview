<UserControl x:Class="Franca.Views.LanguageApplyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,8,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="PlayPauseButton" Width="30" Height="26" Padding="0" Margin="0,0,4,0" Click="OnPlayPause">
            <TextBlock x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE768;"/>
        </Button>
        <Button x:Name="SkipButton" Grid.Column="1" Width="30" Height="26" Padding="0" Margin="0,0,8,0" Click="OnSkip">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9D;"/>
        </Button>
        <ProgressBar x:Name="CountdownProgress" Grid.Column="2" Minimum="0" Maximum="1" Height="6"
                     VerticalAlignment="Center" FlowDirection="LeftToRight"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource GridLineBrush}">
            <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
