<UserControl x:Class="Franca.Views.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Franca.Views"
             Background="{DynamicResource PageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button x:Name="RecentGameButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="Collapsed"
                    Click="OnLaunchClick" Style="{StaticResource AccentButtonStyle}"/>
            <TextBlock x:Name="LibraryTitle" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <!-- 顶部工具条 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,0,16,4" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourceLangLabel" Grid.Column="0" Margin="0,0,0,6"/>
                <TextBlock x:Name="TargetLangLabel" Grid.Column="2" Margin="0,0,0,6"/>
                <TextBlock x:Name="SecondaryLangLabel" Grid.Column="4" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="SourceLanguageCombo" Grid.Row="1" Grid.Column="0" MinHeight="30"
                          SelectionChanged="OnSourceChanged"/>
                <TextBlock x:Name="LanguageArrow" Grid.Row="1" Grid.Column="1" Text="→" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                <ComboBox x:Name="LanguageCombo" Grid.Row="1" Grid.Column="2" MinHeight="30"
                          SelectionChanged="OnSettingChanged"/>
                <Border Grid.Column="3" Grid.RowSpan="2" Width="1" HorizontalAlignment="Center"
                        Background="{DynamicResource GridLineBrush}"/>
                <ComboBox x:Name="SecondaryLanguageCombo" Grid.Row="1" Grid.Column="4" MinHeight="30"
                          SelectionChanged="OnSecondaryChanged"/>
                <local:LanguageApplyBar x:Name="LanguageApply" Grid.Row="2" Grid.ColumnSpan="3"/>
            </Grid>
            <Button x:Name="RescanButton" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" Content="重新扫描" Padding="10,4" Margin="0,24,0,4" Click="OnRescanClick"/>
            <Button x:Name="RefreshSupportButton" Opacity="1" VerticalAlignment="Top" Content="刷新官方支持" Padding="10,4" Margin="8,24,0,4"
                    Click="OnRefreshSupportClick"/>
            <TextBlock x:Name="StatsLabel" VerticalAlignment="Top" Margin="16,30,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid MinWidth="160">
                <TextBox x:Name="GameSearchBox" Padding="8,5,28,5" TextChanged="OnSearchChanged"/>
                <TextBlock x:Name="SearchHintText" Margin="9,0,30,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=GameSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ClearSearchButton" Content="×" HorizontalAlignment="Right" Width="24"
                        Margin="0,2,2,2" Padding="0" Click="OnClearSearchClick"/>
            </Grid>
            <CheckBox x:Name="PriorityToggle" Grid.Column="1" Grid.ColumnSpan="2"
                      IsChecked="True" Checked="OnPriorityChanged" Unchecked="OnPriorityChanged"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <TextBlock x:Name="PriorityLabel" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock x:Name="LibraryHint" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="AutomaticLaunchNote" Visibility="Collapsed" Grid.Row="1" Grid.ColumnSpan="3"
                       Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>

        <!-- 游戏列表 -->
        <DataGrid Grid.Row="3" x:Name="GameGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None" SelectionMode="Single"
                  PreviewMouseDown="OnGameGridPreviewMouseDown"
                  RowDetailsVisibilityMode="VisibleWhenSelected" RowHeaderWidth="0" MinRowHeight="62">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GridLineBrush}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{Binding EngineLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,8"/>
                                <TextBlock Text="{Binding AvailableOfficialSupportLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,8"/>
                                <TextBlock Text="{Binding TranslationHealthText}" ToolTip="{Binding TranslationHealthDetail}" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding TranslationHealthDetail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}" Margin="0,0,20,0">
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  IsEnabled="{Binding CanToggle}" Click="OnToggleClick" Tag="{Binding}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EnableTranslationLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button Content="{Binding RepairConfigLabel}" ToolTip="{Binding RepairConfigHint}" IsEnabled="{Binding CanRepairTranslationConfig}"
                                        Visibility="{Binding NeedsTranslationRepair, Converter={StaticResource BoolToVis}}"
                                        Click="OnRepairConfigClick" Tag="{Binding}" Padding="12,5"/>
                                <Button Content="{Binding UninstallLabel}" ToolTip="{Binding UninstallHint}"
                                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}"
                                        Click="OnUninstallClick" Tag="{Binding}" Padding="12,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="ColName" Header="名称" Width="*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource ControlBackgroundBrush}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="32" Height="32"/>
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LibraryTitle}" ToolTip="{Binding LibraryTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LibrarySubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColTranslated" Visibility="Collapsed" Binding="{Binding TranslatedDisplay}"/>
                <DataGridTextColumn x:Name="ColEngine" Visibility="Collapsed" Binding="{Binding EngineLabel}"/>
                <DataGridTextColumn x:Name="ColStatus" Header="状态" Binding="{Binding LibraryStatusText}" Width="180">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{Binding LibraryStatusColor}"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding LibraryStatusText}"/>
                    </Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColHealth" Visibility="Collapsed" Binding="{Binding TranslationHealthText}"/>
                <DataGridTemplateColumn x:Name="ColAction" Header="操作" Width="220">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid>
                            <!-- 常规操作：启用/启动按钮；静态安装进行中隐藏，换成进度 -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button IsEnabled="{Binding CanPrimaryAction}" Tag="{Binding}" MaxWidth="190"
                                        Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}" Click="OnGamePrimaryClick"
                                        Style="{StaticResource AccentButtonStyle}" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrimaryActionLabel}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="170"/>
                                </Button>
                                <TextBlock Text="{Binding InstallError}" ToolTip="{Binding InstallError}"
                                           Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="200"
                                           Visibility="{Binding HasInstallError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <!-- 静态安装进度：绿色进度条（对齐"已配置"的 OkBrush）+ 最右侧百分比（含字节） -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Value="{Binding InstallPercent, Mode=OneWay}" Maximum="100" Minimum="0" Height="4"
                                             Foreground="{DynamicResource OkBrush}" Background="{DynamicResource ControlBackgroundBrush}"
                                             BorderThickness="0"/>
                                <TextBlock Text="{Binding InstallProgressText}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
