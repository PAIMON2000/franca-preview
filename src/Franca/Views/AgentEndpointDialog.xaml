<Window x:Class="Franca.Views.AgentEndpointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="640" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="PromptText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="12"/>
        <Button x:Name="CopyButton" Grid.Row="2" Click="OnCopy" HorizontalAlignment="Left" Margin="0,8,0,12"/>
        <TextBox x:Name="JsonText" Grid.Row="3" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="12"/>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="{DynamicResource FailBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ImportButton" Click="OnImport" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="CancelButton" Click="OnCancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
