<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Franca</RootNamespace>
    <AssemblyName>Franca</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/franca-taskbar.ico</ApplicationIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.20261027</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.1027.0</FileVersion>
    <InformationalVersion>Franca0.1-1027</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ReleaseVersion" Value="$(Version)" />
    <Resource Include="Assets/Brand/franca-pixel.png"/>
    <Resource Include="Assets/Brand/franca-taskbar.ico"/>
    <Content Include="../../LICENSE;../../docs/THIRD-PARTY-NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../LICENSES/*.txt">
      <Link>LICENSES/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ThirdParty/thtk/*">
      <Link>ThirdParty/thtk/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ThirdParty/thcrap/**/*">
      <Link>ThirdParty/thcrap/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ThirdParty/thcrap-repos/*.json">
      <Link>ThirdParty/thcrap-repos/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ThirdParty/thcrap-stub/franca-thcrap-stub.exe">
      <Link>ThirdParty/thcrap-stub/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!-- Standalone downloads embed the same shipped content, never local settings or caches. -->
  <ItemGroup Condition="'$(FrancaStandalone)' == 'true'">
    <EmbeddedResource Include="../../LICENSE;../../docs/THIRD-PARTY-NOTICES.md"
                      LogicalName="Franca.Distribution/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSES/*.txt"
                      LogicalName="Franca.Distribution/LICENSES/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/thtk/*"
                      LogicalName="Franca.Distribution/ThirdParty/thtk/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/thcrap/**/*"
                      LogicalName="Franca.Distribution/ThirdParty/thcrap/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/thcrap-repos/*.json"
                      LogicalName="Franca.Distribution/ThirdParty/thcrap-repos/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/thcrap-stub/franca-thcrap-stub.exe"
                      LogicalName="Franca.Distribution/ThirdParty/thcrap-stub/%(Filename)%(Extension)" />
    <Content Update="@(Content)" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shift-JIS 读写：thtk 解出的 th10/th11 对话文本为 cp932 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0"/>
  </ItemGroup>

  <Target Name="RefreshLocalShortcut" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(TargetDir)' == '$(MSBuildProjectDirectory)\bin\Release\$(TargetFramework)\'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Launcher\Setup-Shortcut.ps1&quot;" />
  </Target>
</Project>
